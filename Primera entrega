print('\n--- Tuplas de Estudiantes ---')
estudiantes = [
    ("Ana Cristina", 20, 8.5),
    ("Luis Mario", 22, 7.9),
    ("María del socorro", 19, 9.2),
    ("Pedro Pablo", 21, 6.8),
    ("Sofía Angel", 23, 8.1),
    ("Carlos Luis", 20, 7.5),
    ("Laura Estefany", 24, 9.5),
    ("Diego Andres", 18, 7.0)
]

for i in estudiantes:
  nombre, edad, nota = i
  print(f"{nombre} tiene {edad} años y una nota de {nota}.")

print('\n--- Clasificación de Estudiantes ---')
for nombre, edad, nota in estudiantes:
    clasificacion = ""
    if nota >= 9.0:
        clasificacion = "Sobresaliente"
    elif nota >= 8.0:
        clasificacion = "Excelente"
    elif nota >= 7.0:
        clasificacion = "Aprobado"
    else:
        clasificacion = "Reprobado"
    print(f"{nombre}: {clasificacion} (Nota: {nota})")

suma_notas = 0
conteo_estudiantes = 0

for nombre, edad, nota in estudiantes:
    suma_notas += nota
    conteo_estudiantes += 1

if conteo_estudiantes > 0:
    promedio_notas = suma_notas / conteo_estudiantes
    print(f"El promedio de todas las notas es: {promedio_notas:.2f}")
else:
    print("No hay estudiantes para calcular el promedio.")

nombre_buscar = input("Ingrese el nombre del estudiante a buscar: ")

estudiante_encontrado = False
for estudiante in estudiantes:
    # El nombre es el primer elemento de la tupla (indice 0)
    if estudiante[0].lower() == nombre_buscar.lower():
        print(f"¡Estudiante '{estudiante[0]}' encontrado en la lista!")
        estudiante_encontrado = True
        break # Salir del bucle una vez que se encuentra el estudiante

if not estudiante_encontrado:
    print(f"No se encontró ningún estudiante con el nombre '{nombre_buscar}'.")

ciudades_estudiantes = {
    "Ana Cristina": "Bogotá",
    "Luis Mario": "Medellín",
    "María del socorro": "Cali",
    "Pedro Pablo": "Barranquilla",
    "Sofía Angel": "Medellín",
    "Carlos Luis": "Manizales",
    "Laura Estefany": "Pereira",
    "Diego Andres": "Bucaramanga"
}

print('\n--- Ciudades de Residencia ---')
for nombre, ciudad in ciudades_estudiantes.items():
    print(f"{nombre} vive en {ciudad}")

conteo_ciudades = {}
for nombre, ciudad in ciudades_estudiantes.items():
    conteo_ciudades[ciudad] = conteo_ciudades.get(ciudad, 0) + 1

print('\n--- Conteo de Estudiantes por Ciudad ---')
print(conteo_ciudades)

print('\n--- Calculadora de Números (ingrese 0 para finalizar) ---')

contador_numeros = 0
suma_total = 0

while True:
    numero = float(input("Ingrese un número: "))

    if numero == 0:
        break # Finaliza el ciclo si el usuario ingresa 0

    suma_total += numero
    contador_numeros += 1

print(f"Cantidad de números ingresados: {contador_numeros}")
print(f"Suma total: {suma_total}")

if contador_numeros > 0:
    promedio = suma_total / contador_numeros
    print(f"Promedio de los números ingresados: {promedio:.2f}")
else:
    print("No se ingresaron números válidos para calcular el promedio.")

print('\n--- Uso de break y continue (Números del 1 al 30) ---')

for num in range(1, 31):
    if num == 25:
        print(f"¡Número {num} alcanzado! Finalizando el ciclo con break.")
        break # Sale del ciclo si el número es 25

    if num % 3 == 0:
        print(f"Número {num} es múltiplo de 3, saltando con continue.")
        continue # Omite el resto del código en esta iteración si es múltiplo de 3

    print(f"Número procesado: {num}")

